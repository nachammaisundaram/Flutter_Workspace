# simple if_else with Boolean keyword 
void main()
{
  bool rain = true;       //false
  if(rain)
  {
    print("take an umbrella");
  }
  else{
    print("enjoy the sunlight!");
  }
}

o/p: take an umbrella     //enjoy the sunlight!



